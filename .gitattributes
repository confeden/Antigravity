# The Linux launcher assets MUST stay LF. Without this, a Windows checkout with
# core.autocrlf=true rewrites them to CRLF, build_rust.py packs the CRLF copies
# into the Linux bundle, and the `#!/usr/bin/env bash^M` shebang fails on Linux.
*.sh text eol=lf
*.desktop text eol=lf
linux/README.md text eol=lf
*.rs text eol=lf
src/wsl_direct/policy_data/*.xml -text whitespace=-blank-at-eol
src/wsl_direct/policy_data/IANA-LICENSING.html -text whitespace=-blank-at-eol
src/wsl_direct/policy_data/ipnet-2.12.2.index.json -text whitespace=-blank-at-eol
